{
  "name": "viral-ranker-ai-server",
  "version": "1.0.0",
  "description": "Backend server for Viral Ranker AI",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "test": "tsc -p tests/tsconfig.json && node --test --test-concurrency=1 -r ts-node/register/transpile-only \"tests/**/*.test.ts\""
  },
  "keywords": [],
