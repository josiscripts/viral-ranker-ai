# Copy to .env.local and fill in the values you need.

# Gemini API key for the AI features
GEMINI_API_KEY=

# Optional: where the Vite dev server forwards /api (default: http://127.0.0.1:3001)
# API_PROXY_TARGET=http://127.0.0.1:3001

# Optional: backend origin when the frontend is not served behind the /api proxy
# (default: same origin)
# VITE_API_URL=https://api.example.com
